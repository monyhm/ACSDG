<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="interceptor_drone">
    <pose>0 0 0 0 0 0</pose>

    <!-- ── Main body ─────────────────────────────────────────────────── -->
    <link name="base_link">
      <!-- Kinematic velocity-controlled body (see plugin below); gravity
           would fight the velocity plugin between command ticks and drag
           the drone to z=0 whenever cmd_vel stops arriving. -->
      <gravity>false</gravity>
      <!-- High angular damping. gz-sim-velocity-control-system in Harmonic
           does not reset angular velocity per tick — without damping the
           body picks up rotational momentum from numerical noise and
           tumbles indefinitely (no rotational friction with gravity off),
           which then aliases world-frame cmd_vel into wrong directions. -->
      <velocity_decay>
        <linear>0</linear>
        <angular>10</angular>
      </velocity_decay>
      <inertial>
        <mass>2.5</mass>
        <inertia>
          <ixx>0.032</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.032</iyy><iyz>0</iyz>
          <izz>0.055</izz>
        </inertia>
      </inertial>

      <collision name="body_collision">
        <geometry><box><size>0.7 0.7 0.3</size></box></geometry>
      </collision>

      <!-- Central body (green) -->
      <visual name="body_visual">
        <geometry><box><size>0.32 0.32 0.12</size></box></geometry>
        <material>
          <ambient>0.1 0.75 0.2 1</ambient>
          <diffuse>0.1 0.75 0.2 1</diffuse>
          <specular>0.1 0.3 0.1 1</specular>
        </material>
      </visual>

      <!-- Arms -->
      <visual name="arm_ne">
        <pose>0.14 0.14 0 0 0 0.785</pose>
        <geometry><box><size>0.40 0.04 0.03</size></box></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <visual name="arm_nw">
        <pose>-0.14 0.14 0 0 0 -0.785</pose>
        <geometry><box><size>0.40 0.04 0.03</size></box></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <visual name="arm_se">
        <pose>0.14 -0.14 0 0 0 -0.785</pose>
        <geometry><box><size>0.40 0.04 0.03</size></box></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <visual name="arm_sw">
        <pose>-0.14 -0.14 0 0 0 0.785</pose>
        <geometry><box><size>0.40 0.04 0.03</size></box></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>

      <!-- Rotors (larger, green-tinted) -->
      <visual name="rotor_0_vis">
        <pose>0.28 0.28 0.03 0 0 0</pose>
        <geometry><cylinder><radius>0.14</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.05 0.3 0.05 0.7</ambient><diffuse>0.05 0.3 0.05 0.7</diffuse></material>
      </visual>
      <visual name="rotor_1_vis">
        <pose>-0.28 0.28 0.03 0 0 0</pose>
        <geometry><cylinder><radius>0.14</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.05 0.3 0.05 0.7</ambient><diffuse>0.05 0.3 0.05 0.7</diffuse></material>
      </visual>
      <visual name="rotor_2_vis">
        <pose>0.28 -0.28 0.03 0 0 0</pose>
        <geometry><cylinder><radius>0.14</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.05 0.3 0.05 0.7</ambient><diffuse>0.05 0.3 0.05 0.7</diffuse></material>
      </visual>
      <visual name="rotor_3_vis">
        <pose>-0.28 -0.28 0.03 0 0 0</pose>
        <geometry><cylinder><radius>0.14</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.05 0.3 0.05 0.7</ambient><diffuse>0.05 0.3 0.05 0.7</diffuse></material>
      </visual>

      <!-- Green beacon on top -->
      <visual name="top_light">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry><sphere><radius>0.04</radius></sphere></geometry>
        <material>
          <ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse>
          <emissive>0 0.6 0 1</emissive>
        </material>
      </visual>
    </link>

    <!-- ── Rotor links + joints ───────────────────────────────────────── -->
    <link name="rotor_0">
      <pose>0.28 0.28 0.03 0 0 0</pose>
      <gravity>false</gravity>
      <inertial><mass>0.04</mass><inertia><ixx>9.75e-06</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000166704</iyy><iyz>0</iyz><izz>0.000167604</izz></inertia></inertial>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent><child>rotor_0</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit></axis>
    </joint>

    <link name="rotor_1">
      <pose>-0.28 0.28 0.03 0 0 0</pose>
      <gravity>false</gravity>
      <inertial><mass>0.04</mass><inertia><ixx>9.75e-06</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000166704</iyy><iyz>0</iyz><izz>0.000167604</izz></inertia></inertial>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent><child>rotor_1</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit></axis>
    </joint>

    <link name="rotor_2">
      <pose>0.28 -0.28 0.03 0 0 0</pose>
      <gravity>false</gravity>
      <inertial><mass>0.04</mass><inertia><ixx>9.75e-06</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000166704</iyy><iyz>0</iyz><izz>0.000167604</izz></inertia></inertial>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent><child>rotor_2</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit></axis>
    </joint>

    <link name="rotor_3">
      <pose>-0.28 -0.28 0.03 0 0 0</pose>
      <gravity>false</gravity>
      <inertial><mass>0.04</mass><inertia><ixx>9.75e-06</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000166704</iyy><iyz>0</iyz><izz>0.000167604</izz></inertia></inertial>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent><child>rotor_3</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit></axis>
    </joint>

    <!-- ── Velocity control (replaced 4× multicopter-motor-model because
             nothing was publishing motor-speed commands; the interceptor
             controller drives body-frame velocity instead). ────────────── -->
    <plugin filename="gz-sim-velocity-control-system"
      name="gz::sim::systems::VelocityControl">
    </plugin>

    <!-- Odometry publisher (3D — default is 2D, which zeroes pose.z) -->
    <plugin filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>interceptor_drone</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>

  </model>
</sdf>
