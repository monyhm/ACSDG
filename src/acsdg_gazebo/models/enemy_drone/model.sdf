<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="enemy_drone">
    <pose>0 0 0 0 0 0</pose>

    <!-- ── Main body ─────────────────────────────────────────────────── -->
    <link name="base_link">
      <!-- Kinematic velocity-controlled body (see plugin below); gravity
           would fight the velocity plugin between command ticks and drag
           the drone to z=0 whenever cmd_vel stops arriving. -->
      <gravity>false</gravity>
      <!-- See interceptor_drone/model.sdf for the rationale behind the
           angular damping. Enemies are slower so they tumbled less, but
           same plugin behaviour, same fix. -->
      <velocity_decay>
        <linear>0</linear>
        <angular>10</angular>
      </velocity_decay>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.0195</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0195</iyy><iyz>0</iyz>
          <izz>0.0325</izz>
        </inertia>
      </inertial>

      <collision name="body_collision">
        <geometry><box><size>0.5 0.5 0.2</size></box></geometry>
      </collision>

      <!-- Central body (red) -->
      <visual name="body_visual">
        <geometry><box><size>0.25 0.25 0.1</size></box></geometry>
        <material>
          <ambient>0.85 0.1 0.1 1</ambient>
          <diffuse>0.85 0.1 0.1 1</diffuse>
          <specular>0.2 0.05 0.05 1</specular>
        </material>
      </visual>

      <!-- Arm NE -->
      <visual name="arm_ne">
        <pose>0.1 0.1 0 0 0 0.785</pose>
        <geometry><box><size>0.28 0.03 0.02</size></box></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <!-- Arm NW -->
      <visual name="arm_nw">
        <pose>-0.1 0.1 0 0 0 -0.785</pose>
        <geometry><box><size>0.28 0.03 0.02</size></box></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <!-- Arm SE -->
      <visual name="arm_se">
        <pose>0.1 -0.1 0 0 0 -0.785</pose>
        <geometry><box><size>0.28 0.03 0.02</size></box></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <!-- Arm SW -->
      <visual name="arm_sw">
        <pose>-0.1 -0.1 0 0 0 0.785</pose>
        <geometry><box><size>0.28 0.03 0.02</size></box></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>

      <!-- Rotors (visual discs only — no physics) -->
      <visual name="rotor_0_vis">
        <pose>0.2 0.2 0.02 0 0 0</pose>
        <geometry><cylinder><radius>0.1</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 0.7</ambient><diffuse>0.1 0.1 0.1 0.7</diffuse></material>
      </visual>
      <visual name="rotor_1_vis">
        <pose>-0.2 0.2 0.02 0 0 0</pose>
        <geometry><cylinder><radius>0.1</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 0.7</ambient><diffuse>0.1 0.1 0.1 0.7</diffuse></material>
      </visual>
      <visual name="rotor_2_vis">
        <pose>0.2 -0.2 0.02 0 0 0</pose>
        <geometry><cylinder><radius>0.1</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 0.7</ambient><diffuse>0.1 0.1 0.1 0.7</diffuse></material>
      </visual>
      <visual name="rotor_3_vis">
        <pose>-0.2 -0.2 0.02 0 0 0</pose>
        <geometry><cylinder><radius>0.1</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 0.7</ambient><diffuse>0.1 0.1 0.1 0.7</diffuse></material>
      </visual>

      <!-- Red warning light on top -->
      <visual name="top_light">
        <pose>0 0 0.08 0 0 0</pose>
        <geometry><sphere><radius>0.03</radius></sphere></geometry>
        <material>
          <ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse>
          <emissive>0.8 0 0 1</emissive>
        </material>
      </visual>
    </link>

    <!-- ── Velocity control plugin ───────────────────────────────────── -->
    <!-- Accepts gz.msgs.Twist on /model/{name}/cmd_vel                  -->
    <plugin filename="gz-sim-velocity-control-system"
      name="gz::sim::systems::VelocityControl">
    </plugin>

    <!-- ── Odometry publisher (3D — default is 2D, which zeroes pose.z) ── -->
    <plugin filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>enemy_drone</robot_base_frame>
      <odom_publish_frequency>20</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>

  </model>
</sdf>
