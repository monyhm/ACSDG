        </visual>
      </link>
    </model>
    <model name="launch_rail_nw">
      <static>true</static>
      <pose>-177 177 4.5 0 -0.52 2.356</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.15</radius><length>4</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.3 1</ambient><diffuse>0.6 0.6 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Defense post SE: (177, -177) -->
    <model name="defense_post_se">
      <static>true</static>
      <pose>177 -177 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>6 6 3</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>6 6 3</size></box></geometry>
          <material><ambient>0.35 0.40 0.35 1</ambient><diffuse>0.35 0.40 0.35 1</diffuse></material>
        </visual>
