<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="military_base">

    <!-- ── Physics ─────────────────────────────────────────────────────── -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <!-- Drones are kinematic velocity-controlled bodies (see drone model SDFs);
         link-level <gravity>false</gravity> is silently ignored by Harmonic,
         so we zero gravity world-wide. Safe because every other include in
         this world is <static>true</static> and unaffected. -->
    <gravity>0 0 0</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <!-- ── Required plugins ───────────────────────────────────────────── -->
    <plugin filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ── Scene / Lighting ───────────────────────────────────────────── -->
    <scene>
      <ambient>0.6 0.55 0.45 1</ambient>
      <background>0.53 0.71 0.87 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 500 0 0.3 0.785</pose>
      <diffuse>1.0 0.95 0.85 1</diffuse>
      <specular>0.3 0.28 0.25 1</specular>
      <direction>-0.5 0.3 -0.8</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- Ambient fill light -->
    <light name="ambient_fill" type="directional">
      <pose>0 0 100 0 -0.3 -0.785</pose>
      <diffuse>0.3 0.35 0.45 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>0.5 -0.3 -0.6</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ── Ground plane (desert/sand) ────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2000 2000</size>
            </plane>
          </geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2000 2000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.72 0.62 0.45 1</ambient>
            <diffuse>0.72 0.62 0.45 1</diffuse>
            <specular>0.1 0.09 0.07 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- MILITARY BASE COMPOUND                                           -->
    <!-- ════════════════════════════════════════════════════════════════ -->

    <!-- ── Perimeter walls (400m × 400m, 3m high) ────────────────────── -->
    <!-- North wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 200 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>400 1 3</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>400 1 3</size></box></geometry>
          <material>
            <ambient>0.55 0.52 0.48 1</ambient>
            <diffuse>0.55 0.52 0.48 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- South wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -200 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>400 1 3</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>400 1 3</size></box></geometry>
          <material><ambient>0.55 0.52 0.48 1</ambient><diffuse>0.55 0.52 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>200 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1 400 3</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1 400 3</size></box></geometry>
          <material><ambient>0.55 0.52 0.48 1</ambient><diffuse>0.55 0.52 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-200 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1 400 3</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1 400 3</size></box></geometry>
          <material><ambient>0.55 0.52 0.48 1</ambient><diffuse>0.55 0.52 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Main central building (40m × 40m × 15m) ───────────────────── -->
    <model name="main_building">
      <static>true</static>
      <pose>0 0 7.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>40 40 15</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>40 40 15</size></box></geometry>
          <material>
            <ambient>0.50 0.48 0.44 1</ambient>
            <diffuse>0.50 0.48 0.44 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Roof detail: flat slab -->
    <model name="main_building_roof">
      <static>true</static>
      <pose>0 0 15.3 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>42 42 0.6</size></box></geometry>
          <material><ambient>0.4 0.38 0.35 1</ambient><diffuse>0.4 0.38 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Corner guard towers (8m × 8m × 12m) ──────────────────────── -->
    <model name="tower_ne">
      <static>true</static>
      <pose>190 190 6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>8 8 12</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>8 8 12</size></box></geometry>
          <material><ambient>0.52 0.50 0.46 1</ambient><diffuse>0.52 0.50 0.46 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tower_nw">
      <static>true</static>
      <pose>-190 190 6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>8 8 12</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>8 8 12</size></box></geometry>
          <material><ambient>0.52 0.50 0.46 1</ambient><diffuse>0.52 0.50 0.46 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tower_se">
      <static>true</static>
      <pose>190 -190 6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>8 8 12</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>8 8 12</size></box></geometry>
          <material><ambient>0.52 0.50 0.46 1</ambient><diffuse>0.52 0.50 0.46 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tower_sw">
      <static>true</static>
      <pose>-190 -190 6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>8 8 12</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>8 8 12</size></box></geometry>
          <material><ambient>0.52 0.50 0.46 1</ambient><diffuse>0.52 0.50 0.46 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Radar tower at center (cylinder r=2m, h=20m) ──────────────── -->
    <model name="radar_tower_base">
      <static>true</static>
      <pose>0 0 10 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>2</radius><length>20</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>2</radius><length>20</length></cylinder></geometry>
          <material><ambient>0.3 0.32 0.35 1</ambient><diffuse>0.3 0.32 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Radar dish -->
    <model name="radar_dish">
      <static>true</static>
      <pose>0 0 21 0 1.5707 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>3</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Runway / parade ground (marked strip) ─────────────────────── -->
    <model name="parade_ground">
      <static>true</static>
      <pose>0 -80 0.01 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>80 100 0.02</size></box></geometry>
          <material><ambient>0.42 0.40 0.37 1</ambient><diffuse>0.42 0.40 0.37 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Runway centre line markings -->
    <model name="runway_line_1">
      <static>true</static>
      <pose>0 -80 0.02 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>2 90 0.01</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- SENSOR POSTS — hexagon at r=150m                               -->
    <!-- ════════════════════════════════════════════════════════════════ -->

    <!-- Sensor 0: angle=0° → (150, 0) -->
    <model name="sensor_post_0">
      <static>true</static>
      <pose>150 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2 2 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2 2 1.5</size></box></geometry>
          <material><ambient>0.4 0.42 0.45 1</ambient><diffuse>0.4 0.42 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="sensor_antenna_0">
      <static>true</static>
      <pose>150 0 3.5 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.05</radius><length>4</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
