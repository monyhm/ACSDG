    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- DRONE SPAWN POSITIONS (populated by gazebo.launch.py at runtime)-->
    <!-- Interceptor drones at defense posts, enemy drones at perimeter  -->
    <!-- ════════════════════════════════════════════════════════════════ -->

    <!-- Coyote 1 at defense post NE — replaces interceptor_1 in Phase 2.
         Same NE post (177, 177, 20) so the C2 weapon registry's slot-0
         entry takes the same spatial position; only the airframe class
         changes. The post becomes the Coyote's tube-launch site. -->
    <include>
      <uri>model://coyote_b2</uri>
      <name>coyote_1</name>
      <pose>177 177 20 0 0 0</pose>
    </include>

    <!-- Interceptor 2 at defense post NW -->
    <include>
      <uri>model://interceptor_drone</uri>
      <name>interceptor_2</name>
      <pose>-177 177 20 0 0 0</pose>
    </include>

    <!-- DroneHunter F700 at defense post SE (replaces interceptor_3 in Phase 3).
         gz_instance_index=3 matches FLEET slot 3's interceptor_id, so the
         WeaponControllerBase's topic-prefix-by-id_ wiring resolves correctly
         to /model/dronehunter_3/odometry and /dronehunter_3/cmd_vel. -->
    <include>
      <uri>model://dronehunter_f700</uri>
      <name>dronehunter_3</name>
      <pose>177 -177 20 0 0 0</pose>
    </include>

    <!-- Interceptor 4 at defense post SW -->
    <include>
      <uri>model://interceptor_drone</uri>
      <name>interceptor_4</name>
      <pose>-177 -177 20 0 0 0</pose>
    </include>

    <!-- Enemy drones at perimeter (r=300m, evenly spaced 90° apart) -->
    <include>
      <uri>model://enemy_drone</uri>
      <name>enemy_1</name>
      <pose>300 0 30 0 0 3.14159</pose>
    </include>

    <include>
      <uri>model://enemy_drone</uri>
      <name>enemy_2</name>
      <pose>0 300 30 0 0 3.14159</pose>
    </include>

    <include>
      <uri>model://enemy_drone</uri>
      <name>enemy_3</name>
      <pose>-300 0 30 0 0 0</pose>
    </include>

    <include>
      <uri>model://enemy_drone</uri>
      <name>enemy_4</name>
      <pose>0 -300 30 0 0 0</pose>
    </include>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- ECHODYNE ECHOGUARD RADAR — 6 instances on sensor posts          -->
    <!-- Hexagon r=150 m,  one per post,  each faces inward (toward 0,0) -->
    <!-- ════════════════════════════════════════════════════════════════ -->

    <!-- Post 0: angle=0°  → (150, 0).  Yaw=π so +Y faces origin. -->
    <include>
      <uri>model://echoguard</uri>
      <name>echoguard_1</name>
      <pose>150 0 1.555 0 0 3.1416</pose>
      <plugin filename="echoguard_radar_plugin"
              name="acsdg_sensors_hw::EchoGuardRadarPlugin">
        <sensor_id>1</sensor_id>
        <update_rate>25.0</update_rate>
      </plugin>
    </include>

    <!-- Post 1: angle=60° → (75, 129.9).  Yaw = π + π/3 = 4π/3 -->
    <include>
      <uri>model://echoguard</uri>
      <name>echoguard_2</name>
      <pose>75 129.9 1.555 0 0 -2.6180</pose>
      <plugin filename="echoguard_radar_plugin"
              name="acsdg_sensors_hw::EchoGuardRadarPlugin">
        <sensor_id>2</sensor_id>
        <update_rate>25.0</update_rate>
      </plugin>
    </include>

    <!-- Post 2: angle=120° → (-75, 129.9).  Yaw = π + 2π/3 = 5π/3 -->
    <include>
      <uri>model://echoguard</uri>
      <name>echoguard_3</name>
      <pose>-75 129.9 1.555 0 0 -1.5708</pose>
      <plugin filename="echoguard_radar_plugin"
              name="acsdg_sensors_hw::EchoGuardRadarPlugin">
        <sensor_id>3</sensor_id>
        <update_rate>25.0</update_rate>
      </plugin>
    </include>

    <!-- Post 3: angle=180° → (-150, 0).  Yaw = 0 (faces East = origin) -->
    <include>
      <uri>model://echoguard</uri>
      <name>echoguard_4</name>
      <pose>-150 0 1.555 0 0 0</pose>
      <plugin filename="echoguard_radar_plugin"
              name="acsdg_sensors_hw::EchoGuardRadarPlugin">
        <sensor_id>4</sensor_id>
        <update_rate>25.0</update_rate>
      </plugin>
    </include>

    <!-- Post 4: angle=240° → (-75, -129.9).  Yaw = π/3 -->
    <include>
      <uri>model://echoguard</uri>
      <name>echoguard_5</name>
      <pose>-75 -129.9 1.555 0 0 0.5236</pose>
      <plugin filename="echoguard_radar_plugin"
              name="acsdg_sensors_hw::EchoGuardRadarPlugin">
        <sensor_id>5</sensor_id>
        <update_rate>25.0</update_rate>
      </plugin>
    </include>

    <!-- Post 5: angle=300° → (75, -129.9).  Yaw = 2π/3 -->
    <include>
      <uri>model://echoguard</uri>
      <name>echoguard_6</name>
      <pose>75 -129.9 1.555 0 0 1.5708</pose>
      <plugin filename="echoguard_radar_plugin"
              name="acsdg_sensors_hw::EchoGuardRadarPlugin">
        <sensor_id>6</sensor_id>
        <update_rate>25.0</update_rate>
      </plugin>
    </include>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- DEDRONE RF-360 — 4 instances on defense posts (corners r≈250 m) -->
    <!-- ════════════════════════════════════════════════════════════════ -->

    <include>
      <uri>model://rf360</uri>
      <name>rf360_1</name>
      <pose>177 177 3.255 0 0 0</pose>
      <plugin filename="rf360_plugin" name="acsdg_sensors_hw::RF360Plugin">
        <sensor_id>1</sensor_id>
        <update_rate>1.0</update_rate>
      </plugin>
    </include>

    <include>
      <uri>model://rf360</uri>
      <name>rf360_2</name>
      <pose>-177 177 3.255 0 0 0</pose>
      <plugin filename="rf360_plugin" name="acsdg_sensors_hw::RF360Plugin">
        <sensor_id>2</sensor_id>
        <update_rate>1.0</update_rate>
      </plugin>
    </include>

    <include>
      <uri>model://rf360</uri>
      <name>rf360_3</name>
      <pose>177 -177 3.255 0 0 0</pose>
      <plugin filename="rf360_plugin" name="acsdg_sensors_hw::RF360Plugin">
        <sensor_id>3</sensor_id>
        <update_rate>1.0</update_rate>
      </plugin>
    </include>

    <include>
      <uri>model://rf360</uri>
      <name>rf360_4</name>
      <pose>-177 -177 3.255 0 0 0</pose>
      <plugin filename="rf360_plugin" name="acsdg_sensors_hw::RF360Plugin">
        <sensor_id>4</sensor_id>
        <update_rate>1.0</update_rate>
      </plugin>
    </include>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- FLIR BOSON+ 640 — 4 instances on guard towers (compound corners) -->
    <!-- Towers are at ±190 m, height 12 m → sensor at z≈13 m           -->
    <!-- Each Boson faces inward (45° toward base centre)                -->
    <!-- ════════════════════════════════════════════════════════════════ -->

    <include>
      <uri>model://boson_camera</uri>
      <name>boson_1</name>
      <!-- Tower NE (190, 190), face SW: yaw = -3π/4 -->
      <pose>190 190 13 0 -0.26 -2.3562</pose>
    </include>

    <include>
      <uri>model://boson_camera</uri>
      <name>boson_2</name>
      <!-- Tower NW (-190, 190), face SE: yaw = -π/4 -->
      <pose>-190 190 13 0 -0.26 -0.7854</pose>
    </include>

    <include>
      <uri>model://boson_camera</uri>
      <name>boson_3</name>
      <!-- Tower SE (190, -190), face NW: yaw = 3π/4 -->
      <pose>190 -190 13 0 -0.26 2.3562</pose>
    </include>

    <include>
      <uri>model://boson_camera</uri>
      <name>boson_4</name>
      <!-- Tower SW (-190, -190), face NE: yaw = π/4 -->
      <pose>-190 -190 13 0 -0.26 0.7854</pose>
    </include>

  </world>
</sdf>
