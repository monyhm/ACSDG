    <model name="sensor_post_1">
      <static>true</static>
      <pose>75 129.9 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2 2 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2 2 1.5</size></box></geometry>
          <material><ambient>0.4 0.42 0.45 1</ambient><diffuse>0.4 0.42 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="sensor_antenna_1">
      <static>true</static>
      <pose>75 129.9 3.5 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.05</radius><length>4</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
