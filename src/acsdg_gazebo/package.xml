<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>acsdg_gazebo</name>
  <version>0.1.0</version>
  <description>ACSDG Gazebo Harmonic simulation: military base world, drone models, ROS bridges.</description>
  <maintainer email="dev@acsdg.local">ACSDG Dev</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>mavros</depend>
  <depend>acsdg_sensors</depend>
  <depend>acsdg_msgs</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
