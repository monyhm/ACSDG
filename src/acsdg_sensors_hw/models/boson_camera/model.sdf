<?xml version="1.0" encoding="UTF-8"?>
<!--
  FLIR Boson+ 640 Thermal Camera Model — Gazebo Sim (Harmonic / gz-sim8)

  Physical: 44 mm × 44 mm × 30 mm, 28 g
  Spectral: 8–14 μm LWIR,  Resolution: 640×512
  FOV: 50°×40° (9 mm lens, wide-area surveillance)
  Frame rate: 60 Hz,  NETD: <20 mK (simulated as gaussian stddev 0.02 K)

  Mounted on a simple 2-axis gimbal visual (pan/tilt).
  The thermal_camera sensor publishes to:
    /boson_{N}/thermal_image   (gz.msgs.Image, L16 format)
  bridged via ros_gz_bridge → sensor_msgs/Image → boson_node.
-->
<sdf version="1.9">
  <model name="boson_camera">
    <static>true</static>

    <!-- ── Pan base (horizontal rotation axis) ────────────────────────── -->
    <link name="gimbal_pan">
      <visual name="vis_pan_base">
        <geometry>
          <cylinder><radius>0.025</radius><length>0.015</length></cylinder>
        </geometry>
        <material>
          <ambient>0.25 0.25 0.25 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- ── Tilt arm (vertical rotation axis) ──────────────────────────── -->
    <link name="gimbal_tilt">
      <pose>0 0 0.020 0 0 0</pose>
      <visual name="vis_tilt_arm">
        <geometry>
          <box><size>0.012 0.040 0.010</size></box>
        </geometry>
        <material>
          <ambient>0.28 0.28 0.28 1</ambient>
          <diffuse>0.28 0.28 0.28 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- ── Camera body ─────────────────────────────────────────────────── -->
    <link name="camera_link">
      <!-- Mount slightly forward of tilt axis -->
      <pose>0 0.025 0.020 0 0 0</pose>

      <collision name="col_body">
        <geometry>
          <box><size>0.044 0.030 0.044</size></box>
        </geometry>
      </collision>

      <!-- Camera housing: small matte-black box -->
      <visual name="vis_body">
        <geometry>
          <box><size>0.044 0.030 0.044</size></box>
        </geometry>
        <material>
          <!-- Matte black — FLIR Boson+ housing -->
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
        </material>
      </visual>

      <!-- Lens barrel (front face) -->
      <visual name="vis_lens">
        <pose>0 0.017 0 1.5707 0 0</pose>
        <geometry>
          <cylinder><radius>0.012</radius><length>0.008</length></cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.03 0.03 0.03 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>

      <!-- Thermal camera sensor is generated synthetically by boson_node
           (gz thermal_camera requires GPU-backed Ogre2; not available under
           software rendering / WSL2 Mesa llvmpipe). boson_node subscribes to
           /model/enemy_N/odometry and synthesises 640x512 L16 frames with hot
           pixels at projected drone positions — same output topics, same blob
           detector, zero Gazebo GPU dependency. -->
    </link>

  </model>
</sdf>
