<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>acsdg_sensors</name>
  <version>0.1.0</version>
  <description>
    Sensor simulation and fusion nodes for the ACSDG (Anti-Counter Small Drone
    Guidance) system.  Provides simulated radar, RF-detection, and a
    multi-sensor fusion node that outputs FusedTarget tracks.
  </description>
  <maintainer email="mal@acsdg.local">mal</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>acsdg_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
